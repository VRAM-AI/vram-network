# VRAM Network — Miner environment template
# Copy to ~/.vramhub/.env and fill in your mnemonic.
# All contract IDs are pre-filled for v0.8 testnet.

# ── Required ─────────────────────────────────────────────────────────────────
VRAMHUB_WALLET_MNEMONIC=your twelve word mnemonic phrase here

# ── Testnet contract IDs (do not change for testnet) ─────────────────────────
VRAMHUB_PACKAGE_ID=0xf124b60c81a558ae4f63e0ec88efdb08e698962f2589b3d8121ebda1a8be5016
VRAMHUB_PEER_REGISTRY_ID=0x13706d703589023e4688240af87c4933160b773e89bb79d2f047be00644cce98
VRAMHUB_VALIDATOR_REGISTRY_ID=0x20939f845e2ea96827d35b8091600d38c9e9528b787d6ee962d4a76064cbb3fd
VRAMHUB_ENCLAVE_REGISTRY_ID=0x6f7300fe0aa8c642e101cf786d3a13c811a121ce854c6598fa78f145d1699369
VRAMHUB_SCORE_LEDGER_ID=0xe26b307936d9507b9d658ff2663c2632bc724b375dabaeed313c7de1337dc71d
VRAMHUB_ROUND_STATE_ID=0x6532a78963c90acd72e82e71f5ebfb4bd1e27a355ddf6bd880d4cdafcd6c3df0
VRAMHUB_HPARAMS_ID=0x0e14ece7a2a56a560858cf285f23f35cf87573aac61b5121079e06891557c688
VRAMHUB_REWARD_POOL_ID=0x42993815136f0c66cfd4f7ea623b5ce45d56bf73c2a6c79edc2d4b4024175485
VRAMHUB_TRAINING_JOB_BOARD_ID=0x2d646372fa38b890a777a80bec3dd93c9c97fbdf9e8a71fc18b68d6a21d3973c

# ── Storage: Walrus (free on testnet, no credentials needed) ──────────────────
VRAMHUB_STORAGE_BACKEND=walrus
VRAMHUB_DEMO_MODE=true
# Optional: override Walrus endpoints if needed
# VRAMHUB_WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
# VRAMHUB_WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space

# ── Optional: training device (auto-detected if unset) ───────────────────────
# VRAMHUB_DEVICE=cuda:0

# ── Optional: Python sidecar (only needed for --features sidecar) ────────────
# VRAMHUB_SIDECAR_URL=http://127.0.0.1:17070
